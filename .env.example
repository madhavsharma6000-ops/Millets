# Environment Variables
# Local: copy to .env and fill in. Production: set these in Vercel > Settings > Environment Variables.

# --- REQUIRED ---

# Postgres. Added automatically by the Neon integration on Vercel.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Long random string used to sign logins
NEXTAUTH_SECRET=
# Local only. Vercel sets this automatically.
NEXTAUTH_URL=http://localhost:3000

# First admin account, created on the first deploy. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://milletmountain.com

# --- NEEDED FOR IMAGE UPLOADS ---
# Added automatically by connecting a public Vercel Blob store.
# Leave unset locally to save into public/uploads.
BLOB_READ_WRITE_TOKEN=

# --- OPTIONAL ---

# Email (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=

# Payments (Razorpay)
# Server-side only: the checkout page receives the key ID from the API
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Analytics / Search Console
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
